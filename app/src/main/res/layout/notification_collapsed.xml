<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Stats row centered -->
    <LinearLayout
        android:id="@+id/stats_container_collapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon_steps"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/speed"
            android:tint="#3A43B6" />

        <TextView
            android:id="@+id/notification_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0"
            android:textColor="#1F2024"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Divider: Fixed width and darker color for visibility -->
        <TextView
            android:layout_width="1.5dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#D1D5DB" />

        <ImageView
            android:id="@+id/icon_calories"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_calories"
            android:tint="#3A43B6" />

        <TextView
            android:id="@+id/notification_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0"
            android:textColor="#1F2024"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress bar positioned below the stats with space -->
    <ProgressBar
        android:id="@+id/notification_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/stats_container_collapsed"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:progress="0"
        android:progressDrawable="@drawable/notification_progress_drawable" />

</RelativeLayout>